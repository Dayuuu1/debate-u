# Copia este archivo a .env.local. Nunca lo subas a Git.
# Neon > Connect > Connection string
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-HOST.neon.tech/neondb?sslmode=require
# Mínimo 12 caracteres. El acceso al panel pide esta contraseña.
ADMIN_PASSWORD=
# Genera una clave: npm run secret
# Mínimo 32 caracteres; usa la misma clave en todos los despliegues del mismo entorno.
SESSION_SECRET=
